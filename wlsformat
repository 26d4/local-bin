#!/usr/bin/env wolframscript

Needs["CodeFormatter`"]

argv = $ScriptCommandLine

If[Length[argv] < 2, Quit[1]]

content = ReadString[argv[[2]]]
{first, rest} = StringSplit[content, "\n", 2]

hasshebang = StringStartsQ[first, "#!"]

formatted = CodeFormat[If[hasshebang, rest, first <> "\n" <> rest], "IndentationString" -> "\t"]

If[hasshebang, formatted = first <> "\n\n" <> formatted]

If[Length[argv] >= 3,
	WriteString[argv[[3]], formatted],
	Print[formatted]
]