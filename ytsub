#!/usr/bin/env bash

if (( "$#" < 1)); then
	>&2 echo "Usage: ${0##*/} <ID> [<language> [format]]"
	exit
fi

if (( "$#" < 2 )); then
	yt-dlp --ignore-config --no-warnings --skip-download --list-subs "$1"
else
	yt-dlp --ignore-config --no-warnings --skip-download --write-subs --write-auto-subs --sub-langs "$2" "$1"
	if (( "$#" >= 3 )); then
		FILENAME=$(yt-dlp --ignore-config --no-warnings --get-filename "$1")
		FILENAME="${FILENAME%.*}"
		for sub in "$FILENAME."*; do
			if [[ "${sub##*.}" != "$3" ]] && ! ffprobe -hide_banner -show_entries stream=codec_type "$sub" 2> /dev/null | grep -qE '(audio|video)'; then
				ffmpeg -hide_banner -i "$sub" -f "$3" "${sub%.*}.$3"
				rm "$sub"
			else
				echo "File ignored: $sub"
			fi
		done
	fi
fi
