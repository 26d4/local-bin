#!/usr/bin/env bash

if (( "$#" < 1)); then
	>&2 echo "Usage: ${0##*/} <ID> [<language> [format]]"
	exit
fi

if (( "$#" < 2 )); then
	yt-dlp --no-warnings --no-write-subs --no-write-auto-subs --skip-download --list-subs "$1"
else
	DIR=$(mktemp -d)
	yt-dlp -P "$DIR" --no-warnings --skip-download --write-subs --write-auto-subs --sub-format ${3+"$3"/}best --sub-langs "$2" "$1"
	if (( "$#" >= 3 )); then
		for sub in "$DIR"/*; do
			if [[ "${sub##*.}" != "$3" ]]; then
				ffmpeg -hide_banner -i "$sub" -f "$3" "${sub%.*}.$3" && rm "$sub"
			else
				echo "File ignored: $sub"
			fi
		done
	fi
	mv "$DIR"/* "$(dirname "$(yt-dlp --print filename "$1")")"
	rm -r "$DIR"
fi
