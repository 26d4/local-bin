#!/usr/bin/env bash

depend mktemp mkdir xargs xclip yt-dlp || exit

DIR=$(mktemp -d -t "${0##*/}-$$"-ytdl-XXXXX)
QUEUE2="$DIR"/queue2
INFODIR="$DIR"/info

cleanup() {
	jobs -pr | xargs -r kill
	rm -r "$DIR"
}

trap 'cleanup' EXIT

while getopts 'f:F' OPT; do
	case "$OPT" in
		'f')
			FORMAT="$OPTARG"
			;;
		'F')
			FORMAT='-'
			;;
		*);;
	esac
done

xclip -i -selection clipboard < /dev/null
mkdir "$INFODIR"

echo 'Copy URLs to add them -- [F] finish, [C] clear, [Q] quit'

counter=1
prev=$(xclip -selection clipboard -o)
while true; do
	curr=$(xclip -selection clipboard -o)
	if [[ "$curr" != "$prev" ]]; then
		echo "Copied $curr"
		yt-dlp -P "$INFODIR" --print-to-file '%()j' dl"$counter"'%(autonumber)s'.info.json -f 'w*' --print 'Added %(title)s' "$curr" &
		prev="$curr"
		counter=$((counter+1))
	fi

	read -srt0.2 -N1 input
	case "$input" in
		'f'|'F') break;;
		'c'|'C') rm "$INFODIR"/*; counter=1; echo 'Cleared';;
		'q'|'Q') exit 0;;
	esac
done

wait

if [[ -z "$(ls -A "$INFODIR")" ]]; then
	echo "Nothing to download"
	exit
fi

for f in "$INFODIR"/*; do
	printf '%*s\n' "$(tput cols)" '' | tr ' ' '_'
	yt-dlp -f 'w*' --no-sponsorblock --load-info-json "$f" --print "Selecting format for %(title)s"
	if ! yt-dlp -s ${FORMAT+-f "$FORMAT"} --no-sponsorblock --print-to-file "%(format_id)s $f" "$QUEUE2" --load-info-json "$f"; then
		yt-dlp -sf- --no-sponsorblock --print-to-file "%(format_id)s $f" "$QUEUE2" --load-info-json "$f"
	fi
done

[[ -r "$QUEUE2" ]] || exit

clear -x

line=1
while read -r format info; do
	logfile=$(yt-dlp --load-info-json "$info" --print filename)
	logfile=${logfile%.*}.log

	printf '\033[%d;H\033[2K%s' "$line" "$(yt-dlp --load-info-json "$info" --print "%(title)s -- $format")"
	line=$((line+1))

	(
		if yt-dlp --load-info-json "$info" -f "$format" \
			--newline --progress --progress-delta 1 --color always \
			--no-simulate --print "Starting download for %(id)s" --print "after_move:%(id)s done" \
			--quiet --verbose 2> "$logfile"
		then
			rm "$logfile"
		else
			tail -n1 "$logfile"
		fi | xargs -L1 echo -ne "\033[$line;H\033[2K"
	) &

	while (( $(jobs -pr | wc -l) >= 2)); do
		wait -n
	done
	sleep 0.5

	line=$((line+1))
	if ((line+1 > $(tput lines))); then
		line=1
		EXIT_ON_MAX_LINE=1
	fi
done < "$QUEUE2"

wait

printf '\033[%d;H' "${EXIT_ON_MAX_LINE:+$(tput lines)}${EXIT_ON_MAX_LINE-$line}"