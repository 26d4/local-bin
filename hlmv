#!/usr/bin/env bash

depend wine winepath zenity find readlink xargs dirname test || exit

ARGS=()
while (( $# > 0 )); do
	if [[ -e "$1" ]]; then
		if command -v hlam > /dev/null && [[ ! -e "${1%.mdl}.vvd" ]]; then
			exec hlam "$@"
		fi

		FILEDIR=$(dirname "$1")
		ARGS+=("$(winepath -w "$1")")
	else
		ARGS+=("$1")
	fi
	shift
done

HLMVS=()

GAMEDIR=$(
	cd "$FILEDIR" || exit

	while ! [[ -e ./gameinfo.txt ]] && ! [[ "$(pwd)" == / ]]; do
		cd .. || break
	done
	cd ..
	pwd -P
)

mapfile -td '' HLMVS < <(find "$GAMEDIR" -nowarn -maxdepth 4 -iname 'hlmv.exe' -printf '%p\0%P\0')

if (( ${#HLMVS[@]} == 0 )); then
	mapfile -td '' HLMVS < <(
		grep path "$HOME"/.steam/steam/config/libraryfolders.vdf |
		sed 's,^.*path\(\"\|\)\s*\(\"\|\),,; s,\(\"\|\)\s*$,,' |
		xargs -I'{}' find "{}/steamapps/common" -maxdepth 5 -iname 'hlmv.exe' -printf '%p\0%P\0'
	)
fi

HLMV=$(
	case "${#HLMVS[@]}" in
		0) zenity --error --text="No HLMV detected";;
		1|2) echo "${HLMVS[0]}";;
		*)
			printf '%s\0' "${HLMVS[@]}" |
			xargs -0 zenity --width=300 --height=250 --list --column=_ --column=HLMV --hide-column=1 --text='Select HLMV variant'
		;;
	esac
)

[[ -n "$HLMV" ]] || exit

if [[ -z "$VPROJECT" ]]; then
	VPROJECT=$(
		declare -a MODDIRS
		cd "$(dirname "$HLMV")" || exit

		while ! [[ "$(pwd)" == / ]] && ! [[ -e ./steam_appid.txt ]]; do
			cd .. || break
			mapfile -td '' MODDIRS < <(find "$(pwd -P)" -maxdepth 1 -type d -exec test -e "{}/gameinfo.txt" ';' -printf '%p\0%P\0')
			(( ${#MODDIRS[@]} == 0 )) || break
		done

		case "${#MODDIRS[@]}" in
			0) zenity --error --text="No mods with gameinfo.txt";;
			1|2) echo "${MODDIRS[0]}";;
			*)
				printf '%s\0' "${MODDIRS[@]}" |
				xargs -0 zenity --width=300 --height=250 --list --column=_ --column=Directory --hide-column=1 --text='Select mod directory'
			;;
		esac
	)
fi

[[ -n "$VPROJECT" ]] || exit

export VPROJECT

exec wine "$HLMV" "${ARGS[@]}"